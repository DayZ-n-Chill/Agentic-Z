# Copy this file to .env (which is gitignored) and fill in your values.
#
# Required for the RAG layer (/dayz-rag-index + dayz-rag MCP server).
# Get a key at https://dash.voyageai.com — Series-4 models include 200M tokens
# free, enough for ~10 full DayZ rebuilds without paying.
VOYAGE_API_KEY=pa-your-key-here

# Optional — override the embed model. Default is voyage-code-3 (code-tuned, 1024D).
# Other options: voyage-4-large, voyage-4, voyage-4-lite.
# Switching requires a full re-index (python .claude/skills/dayz-rag-index/index.py --full).
# VOYAGE_MODEL=voyage-code-3
