{
  "name": "agentic-z",
  "version": "1.6.0",
  "description": "AI agent stack for DayZ modding. After install, run /dayz-init for a guided setup wizard that takes you from empty repo to mod-loaded-in-DayZ. Ships a 22-agent mod team (orchestrator, router, team leads, specialists and gatekeepers) and 30 DayZ skills covering the full mod pipeline (preflight, scaffold, lint, build PBO, launch test, script-only gates, request routing, types.xml, RAG indexer, p3d audit, particle effects, GUI imageset packing, status line), edit hooks that syntax-check config.cpp and .layout files and keep edits inside the /dayz-scope-mod scope, plus the dayz-rag MCP server for semantic search over vanilla DayZ source.",
  "author": {
    "name": "DayZ n' Chill",
    "url": "https://github.com/DayZ-n-Chill"
  },
  "homepage": "https://agentic-z.com",
  "repository": "https://github.com/DayZ-n-Chill/Agentic-Z",
  "license": "Custom (Agentic-Z License, see LICENSE)",
