// Modal: centred panel, wrapping title + message, two buttons.
// Geometry seen on screen in game on 2026-08-19. Chrome/button spell copied
// from gui/layouts/dialog.layout.
// Hot-reload this file from $profile: (references/hot-iteration.md).
FrameWidgetClass ModalRoot {
	name "ModalRoot"
	// Fullscreen host. ignorepointer 1 so the dim-less margin does not eat clicks
	// around the panel. Same as gui/layouts/dialog_input_text.layout:3.
	// Buttons below do NOT inherit this;
	// they omit the flag.
	ignorepointer 1
	position 0 0
	size 1 1
	// All four flags 0: fraction of the screen. hexact* 1 would be units of
	// 1/1080 of the screen height, measured in game (references/rules-and-checklist.md rule 3, corrected
	// 2026-10-03; this comment called them physical pixels that break 1280x720).
	// Vanilla (227 layouts, 9525 widgets): hexactsize 0 is 6167x vs 3265x for 1.
	hexactpos 0
	vexactpos 0
	hexactsize 0
	vexactsize 0
	// Above vanilla gui/layouts/dialog.layout:15 (priority 1000).
	priority 2000
	{
		PanelWidgetClass ModalPanel {
			name "ModalPanel"
			// RGB from gui/layouts/dialog.layout:5; alpha 0.9608 seen on screen in
			// game on 2026-08-19. rover_sim_colorable tints WhitePixel with this.
			color 0.1176 0.1176 0.1176 0.9608
			// center_ref + position 0 0: under center_ref both the offline parser and
			// the engine ADD position to the centred spot (references/layout-format.md,
			// Zeroing +0.06). This template keeps the offset at 0 0 so the panel sits
			// exactly in the centre.
			position 0 0
			size 0.38 0.70
			halign center_ref
			valign center_ref
			hexactpos 0
			vexactpos 0
			hexactsize 0
			vexactsize 0
			// PanelWidget paints ONLY through a style whose Normal Center is non-empty.
			// rover_sim_colorable: gui/looknfeel/dayzwidgets.styles:3284
			//   Normal Center=WhitePixel, Color=4294967295. Vanilla 641x (top Panel style).
			// Colorable is a WindowWidget style (gui/layouts/dialog.layout:16). On
			// PanelWidget it does not bind: no ImageSet, color never paints
			// (references/styles-format.md, 2026-08-19).
			// ColorablePanel exists on PanelWidget (6x) but Normal Center="" — paints nothing.
			style rover_sim_colorable
			{
				MultilineTextWidgetClass Title {
					name "Title"
					// wrap 1 on MultilineText: 337/339 vanilla. A TextWidget with
					// "text halign" center and no wrap clips BOTH sides on overflow
					// (measured in game 2026-08-19).
					// wrap on TextWidget is 0x in the vanilla layouts, and the
					// attribute is INERT there (measured in-game 2026-08-22:
						// wrap 1 and wrap 0 render the same clipped single line).
						// On a Multiline it works, which is why Title is one.
					wrap 1
					// text_proportion is deliberately NOT declared here. Measured
					// 2026-08-21: the attribute is honoured on TextWidgetClass and on
					// ButtonWidgetClass (glyph = 0.74 x value x box height, inside 2%)
					// and IGNORED on MultilineTextWidgetClass — a cell declaring
					// text_proportion 0.20 measured the same 80 px as a cell declaring
					// nothing at all. MultilineTextWidget extends TextWidget
					// (P:\scripts\1_Core\proto\enwidgets.c:219) and inherits
					// SetTextProportion (:216); inheriting the method does not make the
					// layout attribute work. Until 2026-08-21 this file shipped
					// text_proportion 0.36 here, which did nothing. On a multiline,
					// size the BOX. references/hot-iteration.md section 6.
					ignorepointer 1
					color 1 1 1 1
					position 0.04 0.025
					size 0.92 0.07
					hexactpos 0
					vexactpos 0
					hexactsize 0
					vexactsize 0
					text "#STR_UI_MODAL_TITLE"
					font "gui/fonts/sdf_MetronBook24"
					"text color" 1 1 1 1
					"text halign" center
					"text valign" center
				}
				MultilineTextWidgetClass Message {
					name "Message"
					ignorepointer 1
					color 1 1 1 1
					position 0.04 0.12
					size 0.92 0.58
					hexactpos 0
					vexactpos 0
					hexactsize 0
					vexactsize 0
					text "#STR_UI_MODAL_MESSAGE"
					font "gui/fonts/sdf_MetronLight24"
					"text color" 1 1 1 1
					"text halign" center
					"text valign" top
					// Same wrap 1 as Title. The box is 0.58 tall so two buttons sit
					// under a long body.
					wrap 1
				}
				ButtonWidgetClass BtnYes {
					name "BtnYes"
					// Left of a two-button pair. Vanilla dialog.layout:146 bYes is left
					// (position 15, valign bottom_ref, exact). Proportional stand-in
					// so 1920 and 1280 keep the same fraction. Does not overlap BtnNo.
					position 0.08 0.86
					size 0.38 0.08
					hexactpos 0
					vexactpos 0
					hexactsize 0
					vexactsize 0
					// BODY color, not the label. EmptyHighlight Focus Center=WhitePixel
					// (dayzwidgets.styles:2236-2246); this red tints that pixel.
					// dialog.layout:34.
					// Without it, Focus is white and the default white label is unreadable.
					color 1 0 0 1
					// Stops the parent panel alpha (0.9608) multiplying the Focus fill.
					// 14/28 vanilla EmptyHighlight buttons set this; dialog.layout:4/33.
					inheritalpha 0
					// ButtonWidget/EmptyHighlight: Normal Center="" (no chrome),
					// Highlight Center="", Focus Center=WhitePixel, Pushed Center=BottonPushed.
					// Vanilla dialog chrome: dialog.layout:42, 28x in the vanilla layouts.
					// ButtonWidget/Colorable is more common (176x) and tints in every
					// state; dialogs use EmptyHighlight. Copy the dialog, not the 176.
					style EmptyHighlight
					text "#STR_UI_YES"
					// Vanilla dialog buttons: dialog.layout:44 (0.5) / :193 (0.45).
					// Live here, unlike on the multiline Title above: measured
					// 2026-08-21 at 0.20 and 0.60 in an 86.4 px box against
					// glyph = 0.74 x value x box height, +1.6% and -1.0%.
					text_proportion 0.5
					font "gui/fonts/sdf_MetronBook24"
				}
				ButtonWidgetClass BtnNo {
					name "BtnNo"
					position 0.54 0.86
					size 0.38 0.08
					hexactpos 0
					vexactpos 0
					hexactsize 0
					vexactsize 0
					color 1 0 0 1
					inheritalpha 0
					style EmptyHighlight
					text "#STR_UI_NO"
					text_proportion 0.5
					font "gui/fonts/sdf_MetronBook24"
				}
			}
		}
	}
}
