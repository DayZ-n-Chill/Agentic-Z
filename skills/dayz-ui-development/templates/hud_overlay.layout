// HUD badge pinned to the top-right, no mouse capture.
// Pass-through (ignorepointer 1 on the whole tree) as in vanilla
// gui/layouts/new_ui/hud/hud_player_tag.layout:11 /
// gui/layouts/day_z_hud.layout:446 (line on P:\ for DayZ 1.30).
// Stays proportional so the same fractions land at 1920x1080 and 1280x720.
// Vanilla BadgesPanel uses right_ref with a 252-unit INWARD offset
// (hexactpos 1; references/layout-format.md, drawn edge − parent edge = −252 at
// 1920x1080). The dayz-ui-lab parser models that subtraction
// (scripts/tools/dayz-ui-lab/dayz_ui_lab/parse.py:790-792), with exact units as
// pixels. This file does not copy the offset. An exact offset scales with the
// screen height too (references/rules-and-checklist.md rule 3, corrected 2026-10-03; this comment said
// "hexactpos 1 + 252 px is what breaks 1280x720").
FrameWidgetClass HudOverlayRoot {
	name "HudOverlayRoot"
	// HUD overlays must not steal aim/look.
	ignorepointer 1
	position 0 0
	size 1 1
	hexactpos 0
	vexactpos 0
	hexactsize 0
	vexactsize 0
	// Menus sit at 1000 (gui/layouts/dialog.layout:15) / 2000
	// (modal_panel.layout in this folder). Stay under them.
	priority 100
	{
		PanelWidgetClass HudBadge {
			name "HudBadge"
			ignorepointer 1
			// Dark bar background: color 0.12 0.12 0.12 0.90 + rover_sim_colorable.
			color 0.12 0.12 0.12 0.90
			// Top-right as a fraction: x = 1 - width - margin = 0.76.
			// Equivalent corner to vanilla BadgesPanel (gui/layouts/day_z_hud.layout:514-524 on P:\ for DayZ 1.30,
			// right_ref + 252 exact units inward) without copying the exact offset.
			position 0.76 0.04
			size 0.22 0.10
			// Vanilla writes `halign left` (41x) and `valign top` (36x), never
			// left_ref/top_ref (0x). gui/layouts/day_z_assignments.layout:83-84.
			halign left
			valign top
			hexactpos 0
			vexactpos 0
			hexactsize 0
			vexactsize 0
			// Same Panel paint rule as modal_panel.layout. 641x rover_sim_colorable.
			// ColorablePanel Center="" — do not use it. styles-format.md.
			style rover_sim_colorable
			{
				ImageWidgetClass HudIcon {
					name "HudIcon"
					// Vanilla HUD badge icon: gui/layouts/day_z_hud.layout:534-551
					// (Wetness, image0 set:dayz_gui). Most-used vanilla class (1913x).
					// Vanilla sizes this icon in exact square units (size 35 35,
					// hexactsize/vexactsize 1, fixaspect fixwidth). This box is
					// proportional by design, so it predicts 67.58x60.48 at 1920 --
					// a 1.117:1 box that would squash a square glyph ~12%. Left as is
					// on purpose: fixaspect on a proportional box is not modelled by
					// any parser here, and only a rendered frame settles whether the
					// squash shows. Swap to exact units + fixaspect if it does.
					ignorepointer 1
					position 0.04 0.22
					size 0.16 0.56
					hexactpos 0
					vexactpos 0
					hexactsize 0
					vexactsize 0
					image0 "set:dayz_gui image:iconDrops"
					stretch 1
					mode blend
					"src alpha" 1
				}
				TextWidgetClass HudLabel {
					name "HudLabel"
					ignorepointer 1
					color 1 1 1 1
					position 0.24 0.08
					size 0.70 0.36
					hexactpos 0
					vexactpos 0
					hexactsize 0
					vexactsize 0
					text "#STR_UI_HUD_LABEL"
					font "gui/fonts/sdf_MetronBook24"
					// Short HUD caption: TextWidget, no wrap. wrap belongs on
					// MultilineText (337/339). text_proportion sizes by height;
					// 110x on TextWidget in the vanilla layouts (271x on Button).
					text_proportion 0.70
					"text color" 1 1 1 1
					"text halign" left
					"text valign" center
				}
				TextWidgetClass HudValue {
					name "HudValue"
					ignorepointer 1
					color 1 1 1 1
					position 0.24 0.50
					size 0.70 0.42
					hexactpos 0
					vexactpos 0
					hexactsize 0
					vexactsize 0
					text "#STR_UI_HUD_VALUE"
					font "gui/fonts/sdf_MetronLight24"
					text_proportion 0.64
					"text color" 1 1 1 1
					"text halign" left
					"text valign" center
				}
			}
		}
	}
}
