FrameWidgetClass MenuRoot {
 position 0 0
 size 1 1
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 {
  PanelWidgetClass MenuBackground {
   color 0.0863 0.0863 0.0863 0.902
   size 460 340
   halign center_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   style rover_sim_colorable
   {
    TextWidgetClass LabelTitle {
     ignorepointer 1
     position 0 12
     size 1 28
     halign center_ref
     hexactpos 0
     vexactpos 1
     hexactsize 0
     vexactsize 1
     text "Item Browser"
     font "gui/fonts/sdf_MetronBook24"
     "exact text" 1
     "exact text size" 18
     "bold text" 1
     "text halign" center
     "text valign" center
    }
    EditBoxWidgetClass EditFilter {
     position 8 48
     size 444 28
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style Default
     font "gui/fonts/sdf_MetronLight24"
    }
    TextListboxWidgetClass ItemList {
     clipchildren 1
     position 8 84
     size 444 192
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style Default
     "title visible" 0
     colums "Name;75;Count;25"
     font "gui/fonts/sdf_MetronLight24"
    }
    TextWidgetClass LabelDetail {
     ignorepointer 1
     position 8 284
     size 280 24
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     text ""
     font "gui/fonts/sdf_MetronLight24"
     "exact text" 1
     "exact text size" 12
     "text valign" center
    }
    ButtonWidgetClass BtnRefresh {
     position 118 14
     size 100 28
     halign right_ref
     valign bottom_ref
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style Default
     text "Refresh"
     font "gui/fonts/sdf_MetronBook24"
    }
    ButtonWidgetClass BtnClose {
     userID 1
     position 12 14
     size 100 28
     halign right_ref
     valign bottom_ref
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style Default
     text "Close"
     font "gui/fonts/sdf_MetronBook24"
    }
   }
  }
 }
}