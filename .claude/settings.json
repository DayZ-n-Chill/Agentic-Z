{
  "extraKnownMarketplaces": {
    "superpowers-dev": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers"
      }
    }
  },
  "enabledPlugins": {
    "superpowers@superpowers-dev": true
  },
  "enabledMcpjsonServers": [
    "dayz-rag"
  ],
  "permissions": {
    "allow": [
      "Bash(py --version)",
      "Bash(python --version)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(npm list *)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(python .claude/skills/*)",
      "Bash(python .claude/mcp/*)",
      "Bash(python scripts/*)",
      "Bash(node .claude/skills/*)",
      "Bash(node scripts/*)",
      "PowerShell(. .claude/skills/*)",
      "PowerShell(.claude/skills/*)",
      "Bash(scripts/*.bat)",
      "Bash(scripts/*.bat *)",
      "mcp__dayz-rag__search_dayz_source",
      "mcp__dayz-rag__search_dayz_wiki",
      "mcp__dayz-rag__get_dayz_file",
      "mcp__dayz-rag__list_indexed_sources"
    ],
    "deny": [
      "Bash(python -c *)",
      "Bash(python -m *)",
      "Bash(node -e *)",
      "Bash(node -p *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npx *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/skills/docs-sync/sync.py\" --check --quiet",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
