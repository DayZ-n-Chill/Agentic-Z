{
  "extraKnownMarketplaces": {
    "superpowers-dev": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers"
      }
    }
  },
  "enabledPlugins": {
    "superpowers@superpowers-dev": true
  },
  "enabledMcpjsonServers": [
    "dayz-rag"
  ],
  "permissions": {
    "allow": [
      "Bash(py --version)",
      "Bash(python --version)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(npm list *)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(python .claude/skills/*)",
      "Bash(python .claude/mcp/*)",
      "Bash(python scripts/*)",
      "Bash(python scripts/**)",
      "Bash(node .claude/skills/*)",
      "Bash(node scripts/*)",
      "Bash(node scripts/**)",
      "PowerShell(. .claude/skills/*)",
      "PowerShell(.claude/skills/*)",
      "Bash(scripts/*.bat)",
      "Bash(scripts/*.bat *)",
      "Bash(scripts/**/*.bat)",
      "Bash(scripts/**/*.bat *)",
      "mcp__dayz-rag__search_dayz_source",
      "mcp__dayz-rag__get_dayz_file",
      "mcp__dayz-rag__list_indexed_sources",
      "mcp__plugin_agentic-z_dayz-rag__search_dayz_source",
      "mcp__plugin_agentic-z_dayz-rag__get_dayz_file",
      "mcp__plugin_agentic-z_dayz-rag__list_indexed_sources"
    ],
    "deny": [
      "Bash(format *)",
      "Bash(diskpart *)",
      "PowerShell(Format-Volume *)",
      "PowerShell(Clear-Disk *)",
      "Bash(python -c *)",
      "Bash(python -m *)",
      "Bash(node -e *)",
      "Bash(node -p *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npx *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "P=python; python -c '' >/dev/null 2>&1 || P=py; \"$P\" \"$CLAUDE_PROJECT_DIR/hooks/paste_router.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "P=python; python -c '' >/dev/null 2>&1 || P=py; \"$P\" \"$CLAUDE_PROJECT_DIR/hooks/scope_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "P=python; python -c '' >/dev/null 2>&1 || P=py; \"$P\" \"$CLAUDE_PROJECT_DIR/hooks/edit_check.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "P=python; python -c '' >/dev/null 2>&1 || P=py; \"$P\" \"$CLAUDE_PROJECT_DIR/.claude/skills/agentic-z-update/update.py\" --check --quiet",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/dev/docs-sync.bat\" --check --quiet",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
