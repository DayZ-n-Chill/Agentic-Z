FrameWidgetClass InspectRoot {
 position 0 0
 size 1 1
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 {
  PanelWidgetClass InspectBackground {
   color 0.0863 0.0863 0.0863 0.902
   size 380 340
   halign center_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   style rover_sim_colorable
   {
    TextWidgetClass LabelItemName {
     ignorepointer 1
     position 0 10
     size 1 26
     halign center_ref
     hexactpos 0
     vexactpos 1
     hexactsize 0
     vexactsize 1
     text "Item Name"
     font "gui/fonts/sdf_MetronBook24"
     "exact text" 1
     "exact text size" 16
     "bold text" 1
     "text halign" center
     "text valign" center
    }
    ItemPreviewWidgetClass ItemRender {
     position 50 44
     size 280 236
     halign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
    }
    TextWidgetClass LabelHealth {
     ignorepointer 1
     position 0 288
     size 1 24
     halign center_ref
     hexactpos 0
     vexactpos 1
     hexactsize 0
     vexactsize 1
     text "Condition: Pristine"
     font "gui/fonts/sdf_MetronLight24"
     "exact text" 1
     "exact text size" 13
     "text halign" center
     "text valign" center
    }
    ButtonWidgetClass BtnRotateLeft {
     position 4 0
     size 36 36
     valign center_ref
     hexactpos 1
     vexactpos 0
     hexactsize 1
     vexactsize 1
     style Default
     text "<"
     font "gui/fonts/sdf_MetronBook24"
    }
    ButtonWidgetClass BtnRotateRight {
     position 4 0
     size 36 36
     halign right_ref
     valign center_ref
     hexactpos 1
     vexactpos 0
     hexactsize 1
     vexactsize 1
     style Default
     text ">"
     font "gui/fonts/sdf_MetronBook24"
    }
    ButtonWidgetClass BtnClose {
     position 6 6
     size 24 24
     halign right_ref
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     style Editor
     text "X"
     font "gui/fonts/sdf_MetronBook24"
    }
   }
  }
 }
}