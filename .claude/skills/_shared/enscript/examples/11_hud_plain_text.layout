FrameWidgetClass HudOverlay {
 ignorepointer 1
 position 0 0
 size 1 1
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 {
  TextWidgetClass LabelMain {
   ignorepointer 1
   color 1 1 1 0.9
   position 16 16
   size 200 24
   halign right_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   text "Status: OK"
   font "gui/fonts/sdf_MetronBook24"
   "exact text" 1
   "exact text size" 14
   "text halign" right
   "text valign" center
  }
  TextWidgetClass LabelSub {
   ignorepointer 1
   color 0.8627 0.8627 0.8627 0.8
   position 16 44
   size 200 20
   halign right_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   text ""
   font "gui/fonts/sdf_MetronLight24"
   "exact text" 1
   "exact text size" 12
   "text halign" right
   "text valign" center
  }
  TextWidgetClass LabelWarning {
   visible 0
   ignorepointer 1
   color 1 0.2 0.2 1
   position 0 16
   size 400 28
   halign center_ref
   valign bottom_ref
   hexactpos 0
   vexactpos 1
   hexactsize 1
   vexactsize 1
   text "WARNING: LOW HEALTH"
   font "gui/fonts/sdf_MetronBook24"
   "exact text" 1
   "exact text size" 16
   "bold text" 1
   "text halign" center
   "text valign" center
  }
 }
}