WindowWidgetClass rootWindow {
 color 0.0863 0.0863 0.0863 0.902
 position 0 0
 size 1 1
 halign center_ref
 valign center_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 {
  GridSpacerWidgetClass grid_buttons {
   position 0 0
   size 400 300
   halign center_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   scaled 1
   Padding 10
   Margin 10
   Columns 2
   Rows 2
   {
    ButtonWidgetClass btn_play {
     position 500 500
     size 1 1
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 0
     text "Play"
    }
    ButtonWidgetClass btn_secret {
     visible 0
     size 1 1
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 0
     text "Hidden"
    }
    ButtonWidgetClass btn_options {
     size 1 1
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 0
     text "Options"
    }
    ButtonWidgetClass btn_quit {
     size 1 0.5
     valign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 0
     text "Quit"
    }
   }
  }
 }
}
