/node_modules

# Whole-repo clones made by /dayz-import-mod for a GitHub tree link to a subfolder
/.imports/

# Python
__pycache__/
*.pyc

# Claude Code runtime
.claude/scheduled_tasks.lock

# Per-clone Claude settings (user/machine-specific permissions, hooks, etc.)
.claude/settings.local.json

# Per-clone local memory (user/machine-specific notes; never rules or conventions)
.claude/local-memory/

# Per-clone agentic-z-update state (last-pulled upstream SHA + concurrency lock)
.claude/.upstream-baseline
.claude/.upstream-update.lock*

# Per-agent memory (auto-created by agents at runtime; per-user, never committed)
.claude/agent-memory/

# Superpowers brainstorming Visual Companion — session-local mockups, server state, click events
.superpowers/

# Secrets — API keys, never commit
.env
.env.local
.env.*.local

# Each person's own work and machine, never part of the toolkit: test servers
# (/dayz-add-server recreates them), deliverables, release assets, answer test
# and visual test results, mods in progress, pasted images and the pytest cache.
.server/
output/
workspace/
.claude-images/
.pytest_cache/
*.tar.gz

# Private working docs: never pushed
docs/.updates/
docs/superpowers/

# Claude Code worktrees: full copies of the repo, one per isolated agent session
.claude/worktrees/
