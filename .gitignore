/node_modules

# Whole-repo clones made by /dayz-import-mod for a GitHub tree link to a subfolder
/.imports/

# Python
__pycache__/
*.pyc

# Claude Code runtime
.claude/scheduled_tasks.lock

# Per-clone Claude settings (user/machine-specific permissions, hooks, etc.)
.claude/settings.local.json

# Per-clone local memory (user/machine-specific notes; never rules or conventions)
.claude/local-memory/

# Per-clone agentic-z-update state (last-pulled upstream SHA + concurrency lock)
.claude/.upstream-baseline
.claude/.upstream-update.lock

# Per-agent memory (auto-created by agents at runtime; per-user, never committed)
.claude/agent-memory/

# Superpowers brainstorming Visual Companion — session-local mockups, server state, click events
.superpowers/

# Secrets — API keys, never commit
.env
.env.local
.env.*.local

# Release assets — uploaded to GitHub Releases, not committed (too big for git)
output/release/

# Answer test (evals) results, one file per run
output/evals/
*.tar.gz

workspace/_server/missions/dayzOffline.enoch/storage_1/communityframework/

# DayZ test-server runtime (.server/<instance>/). Logs, profiles, and storage are
# runtime junk and should not be tracked. User-edited serverDZ.cfg and mission/
# contents stay tracked. The pattern ignores what is inside each instance, not
# the instance folder itself: git cannot re-include a file whose parent folder
# is ignored, so `.server/*/` would make the exceptions below dead.
.server/*/*
!.server/*/serverDZ.cfg
!.server/*/mission/
.server/*/mission/storage_*/
# /dayz-gate behavior rebuilds .server/<instance>-behavior/ from <instance>/ on every run.
.server/*-behavior/
# /dayz-gate visual captures, one folder per run. The baselines next to them stay tracked.
output/*-visual/runs/

# Private working docs: never pushed
docs/.updates/
docs/superpowers/

# Claude Code worktrees: full copies of the repo, one per isolated agent session
.claude/worktrees/
